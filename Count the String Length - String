//Count the String Length With Loop and Strlen()

#include<stdio.h>
#include<string.h>
int main()
{

    char str[50];
    int count=0,len;

    printf("Enter Your Text : ");
    fgets(str,sizeof(str),stdin);

    //1
    while(str[count] != '\0'){
        count++;
    }
    //2
    len = strlen(str);

    printf("\n\n");
    printf("The String Length (By loop) is %d\n", count);
    printf("The String Length (By strlen) is %d\n", len);

    return 0;

}
