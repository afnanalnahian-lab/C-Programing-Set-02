//Prime Number with Function

#include<stdio.h>
#include<conio.h>

int isPrime (int num){
       if(num<=1){
        return 0;
       }
       for(int i=2; i<num; i++){
        if(num % i==0){
            return 0;
        }
       } return 1;
}
int main()
{
    //function call

    for(int num=0; num<20; num++){
    if(isPrime(num)){
        printf("%d\is Prime number\n",num);
    } else {
        printf("%d is Not Prime Number\n",num);
    }
    }

    return 0;
}
