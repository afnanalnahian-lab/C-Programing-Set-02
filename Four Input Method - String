//Four Method of Input in String.

#include<stdio.h>
int main()
{
    char str[10];
    int len=0;
    char ch;

    //Scanf Method.
    printf("Getting Input in scanf() : ");
    scanf("%[^\n]s",str);

    printf("\n");
    printf("%s", str);

    //getsf Method.
    printf("Getting Input in gets() : ");
    gets(str);

    printf("\n");
    printf("%s", str);

    //fgets Method.
    printf("Getting Input in fgets() : ");
    fgets(str,sizeof(str),stdin);

    printf("\n");
    printf("%s", str);
    
    //Loop Method.
    printf("Getting Input in Loop() : ");
    while((ch = getchar())!='\n' ){
        if(len<9){
            str[len] = ch;
        }
    }
    str[len]='\0';

    printf("\n");
    printf("%s", str);

    return 0;

}
