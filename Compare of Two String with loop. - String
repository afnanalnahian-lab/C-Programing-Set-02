//Compare of Two String with loop.

#include<stdio.h>
#include<string.h>
int main()
{
    char str1[]="apple";
    char str2[]="appLe";
    int result=0,i=0;

    while(str1[i]!='\0' || str2[i]!= '\0')
    {
        if(str1[i]!=str2[i]){
        result=str1[i]-str2[i];
        //result=str1[i]-str2[i] > 0 ? 1 : -1; (Use Tarnary Oparetor)
        break;
    } i++;
    }


    printf("Result is %d\n",result);
    printf("\n\n");

    if(result==0){
        printf("Str1=str2\n");
    } else if(result<0){
        printf("Str1<str2\n");
    } else {
        printf("Str1>str2\n");
    }

    return 0;
}
