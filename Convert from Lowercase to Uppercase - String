    //Upparcase with toupper
    while(str[i]!='\0'){
        if(str[i]>='a' && str[i]<='z'){
            str[i]=toupper(str[i]);
        } i++;
    }
    printf("\n");
    printf("Lower case to Uppar case with toupper() :  %s\n", str);

    //Lowercase with tolower
    i=0;
    while(str[i]!='\0'){
        if(str[i]>='A' && str[i]<='Z'){
            str[i]=tolower(str[i]);
        } i++;
    }
    printf("\n");
    printf("Uppar case to Lower case with tolower() :  %s\n", str);
}
