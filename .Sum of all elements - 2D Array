//Sum of all elements.

#include<stdio.h>
int main()
{
    int marks[2][2];
    int sum=0;
    //Input
    for(int i=0;i<2;i++){
        for(int j=0;j<2;j++){
            printf("marks[%d][%d]=",i,j);
            scanf("%d",&marks[i][j]);
        }
    }
    //Sum
    for(int i=0;i<2;i++){
        for(int j=0;j<2;j++){
            sum=sum+marks[i][j];
        }
    }
    printf("\n\n");
    //Result

    printf("Sum is %d\n",sum);
    return 0;
}
