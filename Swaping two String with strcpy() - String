//Swaping two String with strcpy()

#include<stdio.h>
#include<string.h>

int main()
{

    char str1[50];
    char str2[50];
    char temp[50];

    printf("str1 :");
    fgets(str1, sizeof(str1),stdin);
    printf("str2 :");
    fgets(str2, sizeof(str2),stdin);

    strcpy(temp,str1);
    strcpy(str1,str2);
    strcpy(str2,temp);

    printf("\n");
    printf("After Swaping.............\n\n");
    printf("Str1: %s\n", str1);
    printf("Str2: %s\n", str2);

    return 0;
}
