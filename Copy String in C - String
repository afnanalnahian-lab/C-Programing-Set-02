//Copy String in C

#include<stdio.h>
#include<string.h>

int main()
{

    char source[50]="Morning Press Bangladesh";
    int destination[50];

    printf("%s\n", source);

    strcpy(destination, source);
    //strncpy(destination, source, 10); //Null na paoway bivinno symbol dekhay. destination[10]='\0';

    printf("\n");
    printf("Destination String (Copyed): %s\n", destination);

    return 0;
}
