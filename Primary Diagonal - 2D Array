//Primary Diagonal - 2D Array

#include<stdio.h>
int main()
{
    int marks[3][3];
    int sum=0;
    //Input
    for(int i=0;i<3;i++){
        for(int j=0;j<3;j++){
            printf("marks[%d][%d]=",i,j);
            scanf("%d",&marks[i][j]);
        }
    }
    //Primary Diagonal (i=j)
    for(int i=0;i<3;i++){
            sum= sum + marks[i][i];//(i==j)
        }
    printf("\n\n");
    //Result

    printf("Primary Diadonal is %d\n",sum);
    return 0;
}
