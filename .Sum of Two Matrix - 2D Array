//Sum of Two 2*2 Matrix.

#include<stdio.h>
int main()
{
    int A[2][2]={{1,2},{3,4}};
    int B[2][2]={{5,6},{7,8}};
    int sum[2][2];
//Sum
    for(int i=0;i<2;i++)
    {
        for(int j=0;j<2;j++)
        {
            sum[i][j]=A[i][j]+B[i][j];
        }
    }
    printf("\n\n");
//Result
    for(int i=0;i<2;i++)
    {
        for(int j=0;j<2;j++)
        {
            printf("Result is %d\n",sum[i][j]);
        }
    }
    return 0;
}
