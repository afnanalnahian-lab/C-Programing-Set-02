//Compare of Two String.

#include<stdio.h>
#include<string.h>
int main()
{
    char str1[]="apple";
    char str2[]="Apple";
    int result;

    result=strcmp(str1,str2);
    printf("Result is %d\n",result);
    printf("\n\n");

    //strcmp(str1,str2,3); You can compare in just first 3 words.
    
    if(result==0){
        printf("Str1=str2\n");
    } else if(result<0){
        printf("Str1<str2\n");
    } else {
        printf("Str1>str2\n");
    }

    return 0;
}
